# ==========================================================
# 🌐 CLOUD-ARCH MASTER CONFIGURATION TEMPLATE (.env.example)
# ==========================================================
# Cara pakai: Salin file ini menjadi .env lalu sesuaikan nilainya:
# cp .env.example .env

# Domain & Server Networking
BASE_DOMAIN=example.com
SERVER_IP=0.0.0.0

# JupyterLab RTC Settings
JUPYTER_TOKEN=admin
JUPYTER_PORT=8888

# GitLab CE Settings
GITLAB_PORT=8080
GITLAB_ROOT_PASSWORD=admin

# MLflow Tracking Server Settings
MLFLOW_PORT=5000
MLFLOW_DEFAULT_USER=admin
MLFLOW_DEFAULT_PASS=admin

# Cloudflare R2 / S3-Compatible Data Lake ($0 Egress)
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=my-datalake-bucket
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
