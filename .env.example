# ==============================================================================
# CLOUD-ARCH MASTER CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Cara pakai: Salin file ini menjadi .env lalu sesuaikan dengan kredensial Anda:
# cp .env.example .env

# --- 1. Domain & Server Networking ---
BASE_DOMAIN=tugasakhir.space
SERVER_IP=34.196.37.78

# --- 2. GitLab Community Edition (CE) ---
GITLAB_PORT=8080
GITLAB_SSH_PORT=2222
GITLAB_ROOT_PASSWORD=InitRootPassMiniProject2026!

# --- 3. Transactional Email & SMTP Gateway (Resend) ---
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
SMTP_DOMAIN=tugasakhir.space
SMTP_FROM_EMAIL=no-reply@tugasakhir.space
SMTP_DISPLAY_NAME=Admin Tugas Akhir

# --- 4. JupyterLab RTC & Real-Time Collaboration ---
JUPYTER_PORT=8888
JUPYTER_TOKEN=miniproject2026

# --- 5. MLflow Tracking Server ---
MLFLOW_PORT=5000
MLFLOW_DEFAULT_USER=admin
MLFLOW_DEFAULT_PASS=admin

# --- 6. Cloudflare R2 Data Lake (S3 Compatible, $0 Egress) ---
R2_ENDPOINT_URL=https://11d2d9aa25f8977089f6f9430db62d02.r2.cloudflarestorage.com
R2_BUCKET_NAME=mini-project-lake
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key

# --- 7. Google Web OAuth 2.0 Client (Untuk Receiver Port 8085) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# --- 8. Telegram Antigravity Gateway Bridge ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_user_id_here
